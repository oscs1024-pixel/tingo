{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "纪要",
  "version": "0.1.0",
  "identifier": "io.github.tancheng33.jiyao",
  "build": {
    "frontendDist": "../../src/jiyao/web",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "纪要",
        "width": 1320,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 680,
        "backgroundColor": "#FAFAFC",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "本地中文会议纪要",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "resources": {
      "bin/jiyao-recorder": "jiyao-recorder"
    }
  }
}
